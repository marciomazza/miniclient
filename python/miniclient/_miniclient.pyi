from typing import Any

class JavaScriptError(Exception):
    name: str
    message: str
    stack: str | None

class Browser:
    def __new__(cls, resource_mounts_json: str = "{}", preboot: bool = True) -> Browser: ...
    def __init__(self, resource_mounts_json: str = "{}", preboot: bool = True) -> None: ...

class Page:
    def __new__(cls, browser: Browser) -> Page: ...
    def __init__(self, browser: Browser) -> None: ...
    async def eval(self, source: str) -> Any: ...
    def find(self, selector: str, text: str | None = None) -> Element | None: ...
    def find_all(self, selector: str, text: str | None = None) -> list[Element]: ...
    async def goto(self, url: str) -> None: ...
    async def load(self, html: str) -> None: ...
    def install_host_ops(
        self,
        fetch: Any,
        fetch_abort: Any,
        fetch_sync: Any,
    ) -> None: ...
    def close(self) -> None: ...

class Element:
    @property
    def text(self) -> str: ...
    @property
    def inner_html(self) -> str: ...
    @property
    def html(self) -> str: ...
    @property
    def tag_name(self) -> str: ...
    def attr(self, name: str) -> str | None: ...
    @property
    def parent(self) -> Element | None: ...
    def find(self, selector: str, text: str | None = None) -> Element | None: ...
    def find_all(self, selector: str, text: str | None = None) -> list[Element]: ...
    async def click(self) -> None: ...
    async def fill(self, value: str) -> None: ...
    async def type(self, value: str) -> None: ...
    async def trigger(self, event: str, event_init: dict[str, Any] | None = None) -> None: ...
    async def request_submit(self) -> None: ...
    async def eval(self, source: str) -> Any: ...
