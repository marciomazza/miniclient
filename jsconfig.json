{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2023", "DOM"],
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "strict": true
    },
    "include": ["js/**/*.js", "js/**/*.d.ts"],
    "exclude": ["js/_generated", "js/polyfills", "node_modules"]
}
